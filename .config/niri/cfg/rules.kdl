

    // if you use steam you will probably like these
window-rule {
    match app-id="steam"
    exclude title=r"^[Ss]team$"
    open-floating true
}

window-rule {
    match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

workspace "gw2" {
    open-on-output "HDMI-A-1"
}

window-rule { match app-id=r"gw2-64.exe"; open-maximized true; open-fullscreen true; open-on-workspace "gw2"; open-on-output "HDMI-A-1"; }

window-rule { match app-id=r"com.heroicgameslauncher.hgl"; open-on-workspace "gw2"; open-on-output "HDMI-A-1"; }
window-rule {
    geometry-corner-radius 3
    clip-to-geometry true
}
